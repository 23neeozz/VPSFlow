# VPSFlow Local Development Environment

# Gateway
GATEWAY_HTTP_ADDR=:8080
GATEWAY_ENV=development
GATEWAY_LOG_LEVEL=debug
GATEWAY_SERVICE_NAME=gateway
AUTH_SERVICE_URL=http://127.0.0.1:8081
IAM_SERVICE_URL=http://127.0.0.1:8082
TENANT_SERVICE_URL=http://127.0.0.1:8083
CLUSTER_SERVICE_URL=http://127.0.0.1:8084
VM_SERVICE_URL=http://127.0.0.1:8085
AGENT_CONTROL_SERVICE_URL=http://127.0.0.1:8086
CONSOLE_SERVICE_URL=http://127.0.0.1:8087

# Auth Service
AUTH_HTTP_ADDR=:8081
AUTH_ENV=development
AUTH_LOG_LEVEL=debug
AUTH_SERVICE_NAME=auth
AUTH_DATABASE_URL=postgres://vpsflow:vpsflow_dev@localhost:5432/vpsflow_auth?sslmode=disable

# IAM Service
IAM_HTTP_ADDR=:8082
IAM_ENV=development
IAM_LOG_LEVEL=debug
IAM_SERVICE_NAME=iam
IAM_DATABASE_URL=postgres://vpsflow:vpsflow_dev@localhost:5432/vpsflow_iam?sslmode=disable

# Tenant Service
TENANT_HTTP_ADDR=:8083
TENANT_ENV=development
TENANT_LOG_LEVEL=debug
TENANT_SERVICE_NAME=tenant
TENANT_DATABASE_URL=postgres://vpsflow:vpsflow_dev@localhost:5432/vpsflow_tenant?sslmode=disable

# Cluster Service
CLUSTER_HTTP_ADDR=:8084
CLUSTER_ENV=development
CLUSTER_LOG_LEVEL=debug
CLUSTER_SERVICE_NAME=cluster
CLUSTER_DATABASE_URL=postgres://vpsflow:vpsflow_dev@localhost:5432/vpsflow_cluster?sslmode=disable

# VM Service
VM_HTTP_ADDR=:8085
VM_ENV=development
VM_LOG_LEVEL=debug
VM_SERVICE_NAME=vm
VM_DATABASE_URL=postgres://vpsflow:vpsflow_dev@localhost:5432/vpsflow_vm?sslmode=disable

# Agent Control Service
AGENT_CONTROL_HTTP_ADDR=:8086
AGENT_CONTROL_ENV=development
AGENT_CONTROL_LOG_LEVEL=debug
AGENT_CONTROL_SERVICE_NAME=agent-control
AGENT_CONTROL_DATABASE_URL=postgres://vpsflow:vpsflow_dev@localhost:5432/vpsflow_agent_control?sslmode=disable
AGENT_CONTROL_COMMAND_TIMEOUT=2m

# Console Service
CONSOLE_HTTP_ADDR=:8087
CONSOLE_ENV=development
CONSOLE_LOG_LEVEL=debug
CONSOLE_SERVICE_NAME=console
CONSOLE_DATABASE_URL=postgres://vpsflow:vpsflow_dev@localhost:5432/vpsflow_console?sslmode=disable
CONSOLE_PUBLIC_URL=http://127.0.0.1:8087
CONSOLE_TOKEN_TTL=5m

# Hypervisor Agent
AGENT_EXECUTOR_MODE=simulate
AGENT_VERSION=0.1.0
AGENT_NODE_NAME=dev-node-1

# Internal service-to-service auth
INTERNAL_API_KEY=dev-internal-api-key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=always_on
OTEL_SERVICE_NAME=gateway

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vpsflow
POSTGRES_PASSWORD=vpsflow_dev
POSTGRES_DB=vpsflow

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# NATS JetStream
NATS_URL=nats://localhost:4222

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=vpsflow
MINIO_SECRET_KEY=vpsflow_dev_secret
MINIO_USE_SSL=false

# JWT (development only — rotate in production)
JWT_SIGNING_KEY=dev-only-change-in-production-min-32-chars
